# 本地开发环境变量（不要在版本库里提交，已在 .gitignore 中排除）
# 这里的值是从旧的 config/config.yaml 里搬过来的真实凭据，
# 它们从此只存在于这个文件（本地）和部署平台的 Secret（线上）。
GATEWAY_PORT=8080
LOG_LEVEL=info
LOG_FORMAT=text


REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- PostgreSQL（租户主数据 + API Key 哈希）----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gateway
POSTGRES_PASSWORD=
POSTGRES_DB=gateway_db
POSTGRES_SSLMODE=disable

BACKEND_QWEN_AWQ=http://localhost:30800
BACKEND_QWEN=http://localhost:11434
BACKEND_LLAMA3=http://localhost:11434
