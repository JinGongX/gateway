# =============================================================
# 环境变量模板：复制成 .env 后填入真实值
#
#   cp .env.example .env
#
# .env 已经在 .gitignore 里，不会被提交；生产环境不要用 .env，
# 直接把这些变量交给 k8s Secret / 容器编排平台注入。
# 环境变量优先级高于 .env，所以容器里注入的值一定能生效。
# =============================================================

# ---- 服务自身 ----
GATEWAY_PORT=8080

# ---- 日志 ----
LOG_LEVEL=info    # debug / info / warn / error
LOG_FORMAT=text   # text（本地）/ json（日志平台采集）

# ---- Redis（限流令牌桶 + 每日配额）----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- PostgreSQL（租户主数据 + API Key 哈希）----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gateway
POSTGRES_PASSWORD=
POSTGRES_DB=gateway_db
POSTGRES_SSLMODE=disable

# ---- 模型后端地址（按需覆盖 config.yaml 里的默认值）----
BACKEND_QWEN_AWQ=http://localhost:30800
BACKEND_QWEN=http://localhost:11434
BACKEND_LLAMA3=http://localhost:11434
